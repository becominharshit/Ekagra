# Public client-side environment variables for Vite/React web & Android apps.
# Copy this file to ".env" or ".env.local" (both are git-ignored; never commit secrets).
# Note: AI keys, Stripe/Razorpay secrets, and service-role keys live ONLY in supabase/functions/.env,
# uploaded to Supabase Vault via `npm run functions:secrets`.

# Supabase public credentials (from Supabase dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional client observability & feature gating
VITE_SENTRY_DSN=
VITE_ENABLE_EXPERIMENTAL_MODULES=false

# Optional contact email (shown in /privacy and feedback forms)
VITE_CONTACT_EMAIL=

# Optional custom URLs when hosting Ekagra and Studio on separate domains
# (By default, Studio is mounted seamlessly at /studio inside the main AppShell)
VITE_STUDIO_URL=
VITE_EKAGRA_URL=
