{
  // Ekagra Studio's code (studio/src). It also checks the parts of Ekagra's src/ it imports.
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.studio.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* "@studio/..." = studio/src, "@/..." = Ekagra's src, "@shared/..." = what the apps share with the Edge Functions */
    "paths": {
      "@studio/*": ["./src/*"],
      "@/*": ["../src/*"],
      "@shared/*": ["../supabase/functions/_shared/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "../src/env.d.ts"]
}
