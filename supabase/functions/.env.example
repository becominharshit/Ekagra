# Edge Function secrets for the AI features: Claude, by Anthropic. Copy this file to
# supabase/functions/.env (that file is git-ignored), paste your Anthropic API key after AI_API_KEY=,
# then run `npm run functions:secrets`. Never put these values in the app's .env: the app must not
# see the AI key.

AI_PROVIDER=anthropic
# From https://platform.claude.com/settings/keys (Create key). It starts with sk-ant-.
AI_API_KEY=

# Claude models (https://platform.claude.com/docs/en/models/overview). These are the defaults.
# Smart: syllabus, past papers, the weekly review, custom hustle plans.
# Fast: lessons, quizzes, the tutor, task capture, the morning brief, marking, meals, speaking.
AI_MODEL_SMART=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5

# How much each model thinks before it answers: none, low, medium or high. More helps hard tasks
# but is slower and costs more (thinking is paid as output). These are the defaults.
AI_REASONING_SMART=low
AI_REASONING_FAST=none

# Prices in USD per 1 million tokens, to log the cost of every request and stop at the budget.
# The app knows them for claude-sonnet-5-5 ($2/$10), claude-haiku-5-5 ($0.10/$0.50; $0.50/$2.50 for
# prompts over 100,000 tokens), claude-opus-5-5, claude-sonnet-4-6 and claude-haiku-4-5
# (https://platform.claude.com/docs/en/about-claude/pricing). Only for another model, set both
# prices of its tier:
# AI_PRICE_SMART_INPUT=
# AI_PRICE_SMART_OUTPUT=
# AI_PRICE_FAST_INPUT=
# AI_PRICE_FAST_OUTPUT=

# Limits. The monthly budget is spread evenly: at most 1/30 of it per 24 hours for the whole app.
AI_MONTHLY_BUDGET_USD=10
AI_USER_DAILY_REQUESTS=150
