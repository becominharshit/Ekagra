# Edge Function secrets for the AI features. Copy this file to supabase/functions/.env
# (that file is git-ignored), fill in AI_API_KEY, then run `npm run functions:secrets`.
# Never put these values in the app's .env: the app must not see the AI key.

AI_PROVIDER=google
# From https://aistudio.google.com/apikey
AI_API_KEY=

# Model names (check https://ai.google.dev/gemini-api/docs/models before changing them).
# Smart = syllabus and past papers. Fast = lessons, quizzes, flashcards, the tutor.
AI_MODEL_SMART=gemini-3.8-flash
AI_MODEL_FAST=gemini-3.5-flash-lite

# Prices in USD per 1 million tokens (paid tier, https://ai.google.dev/gemini-api/docs/pricing).
# They are used to log the cost of every request and to stop at the budget below.
AI_PRICE_SMART_INPUT=0.75
AI_PRICE_SMART_OUTPUT=3.75
AI_PRICE_FAST_INPUT=0.30
AI_PRICE_FAST_OUTPUT=2.50

# Limits. The monthly budget is spread evenly: at most 1/30 of it per 24 hours for the whole app.
AI_MONTHLY_BUDGET_USD=10
AI_USER_DAILY_REQUESTS=150
