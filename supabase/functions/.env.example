# Edge Function secrets for the AI features: Claude, by Anthropic. Copy this file to
# supabase/functions/.env (that file is git-ignored), paste your Anthropic API key after AI_API_KEY=,
# then run `npm run functions:secrets`. Never put these values in the app's .env: the app must not
# see the AI key.

AI_PROVIDER=anthropic
# From https://platform.claude.com/settings/keys (Create key). It starts with sk-ant-.
AI_API_KEY=

# Claude models (https://platform.claude.com/docs/en/models/overview). These are the defaults.
# Smart: syllabus, past papers, the weekly review, custom hustle plans.
# Fast: lessons, quizzes, the tutor, task capture, the morning brief, marking, meals, speaking.
AI_MODEL_SMART=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5

# How much each model thinks before it answers: none, low, medium or high. More helps hard tasks
# but is slower and costs more (thinking is paid as output). These are the defaults.
AI_REASONING_SMART=low
AI_REASONING_FAST=none

# Prices in USD per 1 million tokens, to log the cost of every request and stop at the budget.
# The app knows them for claude-sonnet-5-5 ($2/$10), claude-haiku-5-5 ($0.10/$0.50; $0.50/$2.50 for
# prompts over 100,000 tokens), claude-opus-5-5, claude-sonnet-4-6 and claude-haiku-4-5
# (https://platform.claude.com/docs/en/about-claude/pricing). Only for another model, set both
# prices of its tier:
# AI_PRICE_SMART_INPUT=
# AI_PRICE_SMART_OUTPUT=
# AI_PRICE_FAST_INPUT=
# AI_PRICE_FAST_OUTPUT=

# Limits. The monthly budget is spread evenly: at most 1/30 of it per 24 hours for the whole app.
# Ekagra Studio's requests count against the same budget and daily requests.
AI_MONTHLY_BUDGET_USD=10
AI_USER_DAILY_REQUESTS=150

# ---------------------------------------------------------------------------
# Ekagra Studio (studio-* functions): Gemini, by Google. It can watch YouTube videos.
# ---------------------------------------------------------------------------

# From https://aistudio.google.com/api-keys (Create API key). Remove the # and paste the key.
# GEMINI_API_KEY=

# Optional: checks a YouTube video before Studio makes notes from it (it must be public and at most
# 3 hours long) and gives the material YouTube's title and length. Google Cloud console → APIs &
# Services → enable "YouTube Data API v3" → Credentials → Create API key (restrict it to that API).
# Remove the # and paste the key.
# YOUTUBE_API_KEY=

# Gemini models (https://ai.google.dev/gemini-api/docs/models). These are the defaults.
# Smart: notes, mind maps and revision sheets from PDFs, photos and text.
# Fast (cheaper per token): from YouTube videos, which are long (about 100 tokens a second).
# STUDIO_AI_MODEL_SMART=gemini-3.8-flash
# STUDIO_AI_MODEL_FAST=gemini-3.5-flash-lite

# How much each model thinks first: low, medium or high (Gemini 3 always thinks a little, so not none).
# STUDIO_AI_REASONING_SMART=low
# STUDIO_AI_REASONING_FAST=low

# The app knows the prices of gemini-3.8-flash and gemini-3.6-flash (it counts $1.50/$7.50, Google's
# price from 1 January 2027), gemini-3.5-flash-lite ($0.30/$2.50) and gemini-4-argon
# (https://ai.google.dev/gemini-api/docs/pricing). For another model set both prices of its tier.
# On Gemini's free tier nothing is paid: set all four to 0 so Studio doesn't use up the app's budget
# (the daily requests still count). Google may use free-tier prompts to improve its products.
# STUDIO_AI_PRICE_SMART_INPUT=
# STUDIO_AI_PRICE_SMART_OUTPUT=
# STUDIO_AI_PRICE_FAST_INPUT=
# STUDIO_AI_PRICE_FAST_OUTPUT=
